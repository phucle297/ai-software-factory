---
import { Image } from "astro:assets";
import mark from "../assets/mark.png";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="shell hero">
  <Image
    class="mark"
    src={mark}
    alt=""
    width={64}
    height={64}
    layout="fixed"
    widths={[64, 128]}
    format="webp"
    loading="eager"
    fetchpriority="low"
  />
  <div>
    <p class="eyebrow">Software engineer</p>
    <h1 id="content">{title}</h1>
    <p class="lede">A personal site. The work and the writing will go here.</p>
    <span class="rule" data-entrance></span>
  </div>
</header>
